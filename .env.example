PORT=8080
RUST_LOG=omegaclaw=info,tower_http=info
# Agent runtime. Offline is deterministic and requires no credentials.
OMEGACLAW_PROVIDER=offline
OMEGACLAW_WORKSPACE=.
OMEGACLAW_ALLOW_COMMANDS=false
OMEGACLAW_DB_PATH=omegaclaw.sqlite3
OMEGACLAW_WORKER_MODE=native
OMEGACLAW_DOCKER_NETWORK=none
# Optional provider credentials. Never commit real values.
DIFY_API_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=omegaclaw-security-review
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/interactions
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
